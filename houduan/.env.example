PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
DATABASE_PATH=./data/xvay.sqlite
# 手机上的订阅地址会按这个域名下发。USB 真机先执行 adb reverse tcp:8787 tcp:8787，再保持 127.0.0.1。
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 留空时使用内置管理令牌 admin123。总后台默认账号 admin / admin123。
ADMIN_TOKEN=
TRIAL_BYTES=10737418240
TRIAL_DAYS=7
SESSION_TTL_MS=2592000000
NODE_OFFLINE_MS=180000
ACCEPT_APP_TRAFFIC=0
# 邮箱验证码。配置 SMTP 后才会真正发信；MAIL_DEBUG=1 时接口返回 debugCode，仅用于本地调试。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_DEBUG=0
# 四方支付（易支付兼容）。PAY_DEBUG=1 时可用 /api/pay/debug 模拟支付成功，仅用于本地调试。
PAY_GATEWAY_URL=
PAY_MERCHANT_ID=
PAY_KEY=
PAY_DEBUG=0
